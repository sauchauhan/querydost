# ============================================================
# QueryDost settings. Copy this file to ".env" and fill it in.
# Lines starting with # are ignored.
# ============================================================

# ---------- 1. YOUR DATABASE (one line) ----------
# Use a READ-ONLY login. See README, "Before you point this at a real database".
DATABASE_URL=sqlite:///demo/hr_company.db

# PostgreSQL       (pip install psycopg2-binary)
# DATABASE_URL=postgresql+psycopg2://readonly_user:password@localhost:5432/adventureworks
# MySQL            (pip install pymysql)
# DATABASE_URL=mysql+pymysql://readonly_user:password@10.20.30.40:3306/sales
# SQL Server       (pip install pyodbc, plus "ODBC Driver 18 for SQL Server")
# DATABASE_URL=mssql+pyodbc://readonly_user:password@sqlserver01:1433/SalesDW?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Oracle           (pip install oracledb)
# DATABASE_URL=oracle+oracledb://readonly_user:password@host:1521/?service_name=ORCLPDB1
#
# Password with special characters like @ or # ? Replace them: @ → %40, # → %23

# Optional: only look at some schemas / tables (comma separated). Blank = everything.
# SCHEMAS=sales, person
# ALLOWED_TABLES=employees, leave_requests


# ---------- 2. YOUR MODEL ("provider:model") ----------
# A strong model gives noticeably better SQL. Cheaper option: openai:gpt-5.4-mini
LLM_MODEL=openai:gpt-6.1-sol
OPENAI_API_KEY=sk-...

# Azure OpenAI     (use YOUR deployment name after the colon)
# LLM_MODEL=azure_openai:your-deployment-name
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# OPENAI_API_VERSION=2024-10-21

# Claude (Anthropic)   (pip install langchain-anthropic)
# LLM_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=...

# Claude or others on AWS Bedrock   (pip install langchain-aws, uses your AWS login)
# LLM_MODEL=bedrock_converse:your-bedrock-model-id

# Groq   (pip install langchain-groq)
# LLM_MODEL=groq:llama-3.3-70b-versatile
# GROQ_API_KEY=...

# Leave blank for newer models (they reject it). Use 0 for older ones like gpt-4o.
# LLM_TEMPERATURE=0


# ---------- 3. OPTIONAL TUNING (defaults shown) ----------
# SCHEMA_MODE=auto              # full | lookup | auto (lookup above 15 tables)
# FULL_SCHEMA_MAX_TABLES=15
# SAMPLE_ROWS=3                 # 0 = show the model no data up front
# MAX_ROWS=50
# QUERY_TIMEOUT_SECONDS=30      # PostgreSQL and MySQL
# HISTORY_MESSAGES=12
# APP_TITLE=QueryDost: talk to your database


# ---------- 4. DATA CHANGES (off by default) ----------
# When on, the agent can only PROPOSE a change. A human must click Approve.
# ALLOW_DB_CHANGES=false
# ALLOWED_CHANGE_TYPES=INSERT, UPDATE
# A SEPARATE login that may write, used only after Approve. Not needed for SQLite.
# APPROVER_DATABASE_URL=postgresql+psycopg2://approver_user:password@localhost:5432/adventureworks
