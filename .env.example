# ============================================================
# QueryDost settings. OPTIONAL: the connection screen in the app writes .env for you.
# To edit by hand instead: copy this file to ".env" and fill it in. Lines starting with # are ignored.
# ============================================================

# ---------- 1. YOUR DATABASE ----------
# EASIEST: leave this section alone, run "streamlit run app.py" and use the
# connection screen. It fills these in for you after a successful test.
#
# Nothing set = the demo HR database. Use a READ-ONLY login for real databases.
#
# DB_TYPE: sqlite | postgres | mysql | sqlserver | oracle | snowflake
# DB_TYPE=sqlserver
# DB_HOST=server01.company.local     # SQL Server named instance: SERVER01\SQLEXPRESS
# DB_PORT=                           # blank = the usual port for that database
# DB_NAME=SalesDW                    # Oracle: the service name
# DB_USER=readonly_user
# DB_PASSWORD="any characters are fine here, even @ # / :"
# DB_WINDOWS_LOGIN=false             # SQL Server only: true = use your Windows login, no user/password
# DB_ROLE=                           # PostgreSQL / Snowflake: role to switch to after login
# DB_WAREHOUSE=                      # Snowflake only
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# DB_FILE=demo/hr_company.db         # SQLite only
#
# Drivers: postgres → pip install psycopg2-binary | mysql → pymysql | sqlserver → pyodbc
#          oracle → oracledb | snowflake → snowflake-sqlalchemy
#
# ADVANCED: one SQLAlchemy URL instead of the fields above (it wins if both are set)
# DATABASE_URL=postgresql+psycopg2://readonly_user:password@localhost:5432/adventureworks

# Optional: only look at some schemas / tables (comma separated). Blank = everything.
# PostgreSQL and Oracle also use the first schema as the default schema.
# SCHEMAS=sales, person
# ALLOWED_TABLES=employees, leave_requests


# ---------- 2. YOUR MODEL ("provider:model") ----------
# A strong model gives noticeably better SQL. Cheaper option: openai:gpt-5.4-mini
LLM_MODEL=openai:gpt-6.1-sol
OPENAI_API_KEY=sk-...

# Azure OpenAI     (use YOUR deployment name after the colon)
# LLM_MODEL=azure_openai:your-deployment-name
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# OPENAI_API_VERSION=2024-10-21

# Claude (Anthropic)   (pip install langchain-anthropic)
# LLM_MODEL=anthropic:claude-sonnet-5-5
# ANTHROPIC_API_KEY=...

# Claude or others on AWS Bedrock   (pip install langchain-aws, uses your AWS login)
# LLM_MODEL=bedrock_converse:your-bedrock-model-id

# Groq   (pip install langchain-groq)
# LLM_MODEL=groq:llama-3.3-70b-versatile
# GROQ_API_KEY=...

# Leave blank for newer models (they reject it). Use 0 for older ones like gpt-4o.
# LLM_TEMPERATURE=0


# ---------- 3. OPTIONAL TUNING (defaults shown) ----------
# SCHEMA_MODE=auto              # full | lookup | auto (lookup above 15 tables)
# FULL_SCHEMA_MAX_TABLES=15
# SAMPLE_ROWS=3                 # 0 = show the model no data up front
# MAX_ROWS=50
# QUERY_TIMEOUT_SECONDS=30      # PostgreSQL and MySQL
# HISTORY_MESSAGES=12
# APP_TITLE=QueryDost: talk to your database


# ---------- 4. DATA CHANGES (off by default) ----------
# When on, the agent can only PROPOSE a change. A human must click Approve.
# ALLOW_DB_CHANGES=false
# ALLOWED_CHANGE_TYPES=INSERT, UPDATE
# A SEPARATE login that may write, used only after Approve. Not needed for SQLite.
# APPROVER_DB_USER=approver_user
# APPROVER_DB_PASSWORD=...
# or the advanced form: APPROVER_DATABASE_URL=postgresql+psycopg2://approver_user:password@host:5432/db
